# Static credentials for the local RustFS instance.
# Copy to `.env` and source before `cargo run -p marila`.

MARILA_S3_ENDPOINT=http://localhost:9000
MARILA_S3_ACCESS_KEY_ID=marila
MARILA_S3_SECRET_ACCESS_KEY=marilasecret
MARILA_S3_REGION=eu-west-1
MARILA_BIND_ADDR=0.0.0.0:8080
MARILA_STATE_DB=data/marila.duckdb

# AWS account context (used to shape ARNs in responses so they look like
# what the real AWS service returns).
MARILA_AWS_ACCOUNT_ID=000000000000
